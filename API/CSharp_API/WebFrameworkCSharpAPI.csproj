<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <RootNamespace>Framework</RootNamespace>
    <Title>WebFramework API</Title>
    <Authors>LazyPanda07</Authors>
    <Description>C++ HTTP/HTTPS server with C# API</Description>
    <PackageProjectUrl>https://github.com/LazyPanda07/WebFramework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright ©2024 LazyPanda07</Copyright>
    <RepositoryUrl>https://github.com/LazyPanda07/WebFramework</RepositoryUrl>
    <PackageTags>web;server;framework</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyVersion>3.4.2</AssemblyVersion>
    <FileVersion>3.4.2</FileVersion>
    <Version>3.4.2</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="Windows/WebFramework.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="Windows/FileManager.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="Windows/Localization.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="Windows/Log.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="Windows/sqlite3.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />

    <None Include="Linux/libWebFramework.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="Linux/libFileManager.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="Linux/libLocalization.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="Linux/libLog.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="Linux/libsqlite3.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />

    <None Include="LinuxARM/libWebFramework.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="LinuxARM/libFileManager.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="LinuxARM/libLocalization.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="LinuxARM/libLog.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="LinuxARM/libsqlite3.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BOOST_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="CMARK_GFM_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="HIREDIS_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="JWT-CPP_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="OPEN_SSL_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="PYBIND11_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="rabbitmq-c_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="SQLITE3_LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
